@Zestora_API_HostAddress = http://localhost:5018

GET {{Zestora_API_HostAddress}}/weatherforecast/
Accept: application/json

# Customer Endpoints

### Get customer
GET {{Zestora_API_HostAddress}}/api/customer
Accept: application/json

###

# Product Endpoints

### Get All Products
GET {{Zestora_API_HostAddress}}/api/product
Accept: application/json

###

### Get Product By Id
GET {{Zestora_API_HostAddress}}/api/product/d59709a8-e151-4be1-948f-3d81a0f7058c
Accept: application/json

###

### Create Product
POST {{Zestora_API_HostAddress}}/api/product
Content-Type: application/json

{
  "productName": "MSI PRO B760M-A WIFI DDR4",
  "salePrice": 149.99,
  "quantity": 18,
  "shortDescription": "Placa base Intel B760 con WiFi 6",
  "productDescription": "Placa base MSI PRO B760M-A WIFI DDR4, socket LGA1700 para procesadores Intel Core de 12ª, 13ª y 14ª generación, DDR4, PCIe 4.0, WiFi 6, formato Micro-ATX",
  "productType": "simple",
  "sku": "MSI-B760M-WIFI-DDR4",
  "comparePrice": 169.99,
  "buyingPrice": 110.00,
  "published": true
}


###

### Create Bulk Products
POST {{Zestora_API_HostAddress}}/api/product/bulk
Content-Type: application/json

{
  "products": [
    {
      "productName": "MacBook Pro 14",
      "salePrice": 1999.99,
      "quantity": 30,
      "shortDescription": "MacBook Pro con chip M3 Pro",
      "productDescription": "MacBook Pro de 14 pulgadas con chip M3 Pro, 18GB RAM, 512GB SSD",
      "productType": "Simple",
      "sku": "MBP-14-M3",
      "comparePrice": 2199.99,
      "buyingPrice": 1600.00,
      "published": true
    },
    {
      "productName": "AirPods Pro 2",
      "salePrice": 249.99,
      "quantity": 100,
      "shortDescription": "AirPods Pro con cancelación de ruido",
      "productDescription": "AirPods Pro de segunda generación con cancelación activa de ruido y audio espacial",
      "productType": "Simple",
      "sku": "AIRPODS-PRO-2",
      "comparePrice": 279.99,
      "buyingPrice": 180.00,
      "published": true
    }
  ]
}

